Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: uav1_local_nwu
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/Map
      Name: AccumulatedGlobalMap
      Enabled: true
      Alpha: 0.75
      Topic:
        Value: /uav1/global_map
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: ObservedLocalMap
      Enabled: false
      Alpha: 0.55
      Topic:
        Value: /uav1/local_map
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/Odometry
      Name: Px4EstimatedOdom
      Enabled: true
      Keep: 1
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 100; 20
        Alpha: 1
      Topic:
        Value: /uav1/odom
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.35
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/Path
      Name: LocalPath
      Enabled: true
      Topic:
        Value: /uav1/local_path
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color: 40; 220; 100
    - Class: rviz_default_plugins/Image
      Name: Infrared
      Enabled: true
      Topic:
        Value: /uav1/cam0/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic: /uav1/goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 38
      Pitch: 1.2
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 850
