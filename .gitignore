# ROS2 编译产物
build/
install/
log/

# Python
__pycache__/
*.pyc

# third_party 克隆的开源项目（由 setup_env.sh 拉取）
third_party/px4_msgs/
src/px4_msgs

# 模型文件（体积大，单独分发）
src/uav_perception/models/*.rknn

# 全机 D435i 模式自动生成的 per-drone 模型（start_sim_4uav.sh 每次启动重新生成）
worlds/models/.gen/
# Generated from the bundled 3 m STL archive at simulation startup.
worlds/models/rmuc_2025/meshes/rmuc_2025.stl

# Local export bundles and benchmark output (sources/tools are versioned)
/algorithm_upgrade.patch
/algorithm_upgrade.zip
/camera_geometry_fix.patch
/local_core_benchmark.json
/tmp/
/output/
